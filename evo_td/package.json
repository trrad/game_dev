{
  "scripts": {
    "demo:client": "webpack serve --config webpack.client.config.js --mode development",
    "demo:server": "webpack --config webpack.server.config.js --mode development --watch & node dist/server/server.bundle.js",
    "demo:build": "npm run demo:build:client && npm run demo:build:server",
    "demo:build:client": "webpack --config webpack.client.config.js --mode production",
    "demo:build:server": "webpack --config webpack.server.config.js --mode production",
    "demo:all": "concurrently \"npm run demo:client\" \"npm run demo:server\"",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "ts-loader": "^9.5.0",
    "html-webpack-plugin": "^5.5.3",
    "webpack-node-externals": "^3.0.0",
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.5"
  }
}